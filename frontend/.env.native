# Build settings for the native (Capacitor) shell only.
#
# Loaded by `npm run build:native` (vite build --mode native). The regular web
# build (`npm run build`) does NOT read this file and keeps using the
# same-origin relative `/api`, so nothing here affects the deployed web app.
#
# Point this at a Django host the phone can actually reach:
#   - the emulator reaches your PC at http://10.0.2.2:8000/api
#   - a physical device needs your machine's LAN IP, e.g. http://192.168.1.23:8000/api
# Django already answers cross-origin (CORS_ALLOW_ALL_ORIGINS) and the Android
# shell sets allowMixedContent so an http LAN host works from the https WebView.
VITE_API_BASE=http://10.0.2.2:8000/api
